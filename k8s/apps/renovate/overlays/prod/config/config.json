{
    "repositories": [
        "tristan/infrastructure",
        "tristan/kube-prometheus-k8s-235"
    ],
    "prConcurrentLimit": 100,
    "prHourlyLimit": 0,
    "detectHostRulesFromEnv": true,
    "hostRules": [
        {
            "matchHost": "ghcr.io",
            "maxRequestsPerSecond": 1,
            "abortOnError": true,
            "abortIgnoreStatusCodes": [404]
        }
    ]
}
