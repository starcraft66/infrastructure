{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "nix": {
        "enabled": true,
        "lockFileMaintenance": {
            "enabled": true,
        },
    },
    "packageRules": [
        {
            "description": "Pin docker image digests in kustomize images: (floating tags are rebuilt on base image updates without a version bump)",
            "matchManagers": [
                "kustomize",
            ],
            "matchDatasources": ["docker"],
            "pinDigests": true,
        },
        {
            "description": "Immich is versioned from GitHub releases so no docker digest is available; hedgedoc carries its tag in the image name",
            "matchFileNames": [
                "k8s/apps/immich/overlays/prod/kustomization.yaml",
                "k8s/apps/ctfnote/overlays/prod/kustomization.yaml",
            ],
            "matchPackageNames": [
                "ghcr.io/immich-app/immich-server",
                "quay.io/hedgedoc/hedgedoc",
            ],
            "pinDigests": false,
        },
        {
            "description": "Group mediaserver stack dependencies which usually have no proper semver versioning",
            "matchFileNames": [
                "k8s/apps/mediaserver/**"
            ],
            "matchManagers": [
                "kustomize",
                "helm-values",
            ],
            "groupName": "mediaserver packages",
            "pinDigests": true,
        },
        // home-automation packages
        {
            "description": "Group home-automation stack dependencies",
            "matchFileNames": [
                "k8s/apps/home-automation/**"
            ],
            "matchManagers": [
                "kustomize",
                "helm-values",
            ],
            "groupName": "home automation packages",
            "pinDigests": true,
        },
        {
            "description": "home-automation: Helm chart version fields cannot carry a digest (Renovate forces pinDigests=false for OCI charts and Flux helmCharts take semver only)",
            "matchFileNames": [
                "k8s/apps/home-automation/**"
            ],
            "matchManagers": [
                "kustomize",
            ],
            "matchDepTypes": [
                "HelmChart",
            ],
            "pinDigests": false,
        },
        {
            "description": "Read Immich versions from releases instead of walking the large GHCR tag list",
            "matchFileNames": ["k8s/apps/immich/overlays/prod/kustomization.yaml"],
            "matchManagers": ["kustomize"],
            "matchDatasources": ["docker"],
            "matchPackageNames": ["ghcr.io/immich-app/immich-server"],
            "overrideDatasource": "github-releases",
            "overridePackageName": "immich-app/immich",
            "versioning": "semver",
        },
        {
            "description": "Minecraft server versions: Paper lists a version as soon as experimental builds exist, but itzg only installs STABLE builds by default",
            "matchManagers": ["custom.regex"],
            "matchDatasources": ["custom.papermc"],
            "commitMessageTopic": "Minecraft {{depName}} server version",
            "prBodyNotes": [
                "Before merging: check https://fill.papermc.io/v3/projects/{{packageName}}/versions/{{newVersion}}/builds has a `STABLE` build (otherwise the server crash-loops with \"No build found ... channel 'default'\"), and that the server's plugins support {{newVersion}}."
            ],
        },
        {
            "description": "Minecraft vanilla server versions from Mojang",
            "matchManagers": ["custom.regex"],
            "matchDatasources": ["custom.mojang"],
            "commitMessageTopic": "Minecraft {{depName}} server version",
            "prBodyNotes": [
                "Merging upgrades the world on next start and it can't be downgraded afterwards; make sure a recent backup of the world volume exists."
            ],
        },
        {
            "description": "Skip changelog fetching for huge monorepos; recursive git-tree walks take minutes and stall the run",
            "matchSourceUrls": [
                "https://github.com/bitnami/charts",
                "https://github.com/renovatebot/renovate",
            ],
            "fetchChangeLogs": "off",
        },
    ],
    "customDatasources": {
        // Official Minecraft releases (snapshots, pre-releases and RCs excluded) from Mojang's launcher manifest
        "mojang": {
            "defaultRegistryUrlTemplate": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
            "transformTemplates": [
                "{\"homepage\": \"https://www.minecraft.net/en-us/download/server\", \"releases\": [versions[type = \"release\"].{\"version\": id, \"releaseTimestamp\": releaseTime}]}"
            ],
        },
        // Minecraft versions that have Paper builds; '-rc'/'-pre' ids are dropped so only official releases remain
        "papermc": {
            "defaultRegistryUrlTemplate": "https://fill.papermc.io/v3/projects/{{packageName}}/versions",
            "transformTemplates": [
                "{\"homepage\": \"https://papermc.io/downloads/{{packageName}}\", \"releases\": [versions[$not($contains(version.id, \"-\"))].{\"version\": version.id}]}"
            ],
        },
    },
    "customManagers": [
        {
            "description": "Track Minecraft server VERSION env vars annotated with a '# renovate:' comment",
            "customType": "regex",
            "managerFilePatterns": [
                "/^k8s\\/apps\\/minecraft\\/.+\\/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?\\s*\\n\\s*-\\s*VERSION=(?<currentValue>\\S+)"
            ],
            "versioningTemplate": "loose"
        },
        {
            "description": "Track CloudNativePG release manifests by GitHub release tag",
            "customType": "regex",
            "managerFilePatterns": [
                "/^k8s\/apps\/cloudnative-pg\/base\/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "https://raw\\.githubusercontent\\.com/cloudnative-pg/cloudnative-pg/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/releases/cnpg-\\d+\\.\\d+\\.\\d+\\.yaml"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "cloudnative-pg/cloudnative-pg",
            "versioningTemplate": "semver",
            "autoReplaceStringTemplate": "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/v{{{newValue}}}/releases/cnpg-{{{newValue}}}.yaml"
        },
        {
            "description": "Track KubeVirt operator release manifests by GitHub release tag",
            "customType": "regex",
            "managerFilePatterns": [
                "/^k8s\/apps\/kubevirt\/base\/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "https://github\\.com/kubevirt/kubevirt/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/kubevirt-operator\\.yaml"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "kubevirt/kubevirt",
            "versioningTemplate": "semver",
            "autoReplaceStringTemplate": "https://github.com/kubevirt/kubevirt/releases/download/v{{{newValue}}}/kubevirt-operator.yaml"
        },
        {
            "description": "Track KubeVirt CDI operator release manifests by GitHub release tag",
            "customType": "regex",
            "managerFilePatterns": [
                "/^k8s\/apps\/kubevirt-cdi\/base\/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "https://github\\.com/kubevirt/containerized-data-importer/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/cdi-operator\\.yaml"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "kubevirt/containerized-data-importer",
            "versioningTemplate": "semver",
            "autoReplaceStringTemplate": "https://github.com/kubevirt/containerized-data-importer/releases/download/v{{{newValue}}}/cdi-operator.yaml"
        }
    ]
}
